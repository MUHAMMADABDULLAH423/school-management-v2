rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userDoc().role : null;
    }
    function isPrincipal() { return role() == 'principal'; }
    function isAdmin()     { return role() == 'admin' || isPrincipal(); }
    function isTeacher()   { return role() == 'teacher'; }
    function isStaffRole() { return role() == 'staff'; }
    function isParent()    { return role() == 'parent'; }

    // "Today" as a YYYY-MM-DD string (UTC — matches the app's todayStr(),
    // which is an ISO date slice, also UTC). Used to stop teachers editing
    // past attendance; admin/principal keep full access.
    function todayStr() {
      return string(request.time.year()) + '-'
        + (request.time.month() < 10 ? '0' + string(request.time.month()) : string(request.time.month())) + '-'
        + (request.time.day() < 10 ? '0' + string(request.time.day()) : string(request.time.day()));
    }
    function isTodayDate(d) { return d == todayStr(); }

    // parentId stored on the linked student doc; parentEmail is the fallback so
    // links created before the parent's first login keep working after the
    // placeholder users doc is adopted to the real auth uid.
    function studentDoc(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId)).data;
    }
    function parentOfStudent(studentId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/students/$(studentId))
        && (studentDoc(studentId).parentId == request.auth.uid
            || studentDoc(studentId).parentEmail == request.auth.token.email);
    }

    // ---- SCHOOL PROFILE ----
    match /schools/{schoolId} {
      allow get, list: if isSignedIn();
      // principal and admin manage name/address/bank accounts
      allow create, update: if isPrincipal() || role() == 'admin';
      allow delete: if false;
    }

    // ---- USER ACCOUNTS ----
    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId || isAdmin() ||
        // placeholder adoption: principal/admin create email-keyed placeholders
        // that the owner reads on first login to adopt to their auth uid
        userId == request.auth.token.email ||
        userId == 'pending_' + request.auth.token.email
      );
      allow list: if isAdmin();
      // ADMIN and PRINCIPAL may create accounts of any role (Users menu lives in
      // the principal portal). Placeholders use email-keyed ids (pending_<email>).
      allow create: if isSignedIn() && (
        isAdmin() ||
        // self-claim on first login: adopt your own placeholder to your auth uid.
        // Creating the Firebase Auth account (console access required) is the
        // authorization; the email must match the login email exactly.
        (request.auth.uid == userId
          && request.resource.data.email == request.auth.token.email)
      );
      // Admin/Principal: full update (user management). User: own profile, limited fields.
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'phone', 'photoURL', 'isFirstLogin']))
      );
      allow delete: if isAdmin()
        // owner may delete their own email-keyed placeholder after adoption
        || (isSignedIn() && resource.data.email == request.auth.token.email);
    }

    // ---- STUDENTS: ADMIN ONLY for writes. Principal can NEVER write students. ----
    // read rule uses resource.data so list queries only return permitted docs
    match /students/{studentId} {
      allow read: if isSignedIn() && (
        isAdmin() || isTeacher() || isStaffRole() ||
        (isParent() && (resource.data.parentId == request.auth.uid
          || resource.data.parentEmail == request.auth.token.email))
      );
      allow create, update, delete: if role() == 'admin';
    }

    // ---- STAFF (teachers + non-teaching): principal and admin manage ----
    match /staff/{staffId} {
      allow get, list: if isSignedIn();
      allow create, update: if isPrincipal() || role() == 'admin';
      // delete is PRINCIPAL-ONLY (admin can add/edit/deactivate, never delete)
      allow delete: if isPrincipal();
    }

    match /classes/{classId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---- ATTENDANCE ----
    // Teachers may write ONLY today's student attendance (create + update);
    // past dates are read-only for them, enforced here AND in the UI.
    // Admin/principal keep full access (they can correct past records).
    // Staff self check-in is likewise today-only, own record, Present only.
    match /attendance/{id} {
      allow read: if isSignedIn() && (
        !isParent() ||
        (resource.data.type == 'student' && parentOfStudent(resource.data.studentId))
      );
      allow create: if isAdmin() ||
        (isTeacher() && isTodayDate(request.resource.data.date)
          && request.resource.data.type == 'student') ||
        // staff may check THEMSELVES in: own staff record only, Present only.
        // (userDoc().staffId links the login to the staff record.)
        (isStaffRole() && isTodayDate(request.resource.data.date)
          && request.resource.data.type == 'staff'
          && request.resource.data.status == 'Present'
          && request.resource.data.staffId == userDoc().staffId);
      allow update: if isAdmin() ||
        (isTeacher() && isTodayDate(resource.data.date)
          && request.resource.data.date == resource.data.date
          && request.resource.data.type == 'student'
          && resource.data.type == 'student') ||
        (isStaffRole() && isTodayDate(resource.data.date)
          && request.resource.data.date == resource.data.date
          && request.resource.data.type == 'staff'
          && request.resource.data.status == 'Present'
          && request.resource.data.staffId == userDoc().staffId
          && resource.data.staffId == userDoc().staffId);
      // delete widened so the principal's staff-delete cascade can remove
      // the deleted member's check-in records (student rows are untouched:
      // the cascade only matches staffId)
      allow delete: if isAdmin();
    }

    // ---- FEES ----
    match /fees/{feeId} {
      allow read: if isSignedIn() && (
        isAdmin() || (isParent() && parentOfStudent(resource.data.studentId))
      );
      allow create, update, delete: if role() == 'admin';
    }

    // ---- ONLINE FEE PAYMENT CLAIMS (parent submits proof, admin approves) ----
    // Parents create claims for their OWN children only (status must start
    // 'pending'); only admins can review them. A claim never pays a fee by
    // itself — the admin's Approve writes the fee voucher.
    match /paymentClaims/{claimId} {
      allow read: if isSignedIn() && (
        isAdmin() || (isParent() && parentOfStudent(resource.data.studentId))
      );
      allow create: if isSignedIn() && isParent()
        && parentOfStudent(request.resource.data.studentId)
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ---- RESULTS / MARKS ----
    match /results/{resultId} {
      allow read: if isSignedIn() && (
        isAdmin() || isTeacher() || (isParent() && parentOfStudent(resource.data.studentId))
      );
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if role() == 'admin';
    }

    match /exams/{examId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if role() == 'admin';
    }

    // ---- EXAM TYPES (teacher-addable exam names for marks entry) ----
    match /examTypes/{typeId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() || isTeacher();
      allow update, delete: if role() == 'admin';
    }

    match /timetable/{slotId} {
      allow get, list: if isSignedIn();
      allow create, update: if role() == 'admin';
      // delete widened so the principal's staff-delete cascade can remove
      // the deleted teacher's periods (timetable editing stays admin-only)
      allow delete: if isAdmin();
    }

    match /diary/{diaryId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if role() == 'admin';
    }

    match /notifications/{nid} {
      allow read: if isSignedIn() && (
        resource.data.audience == 'all' ||
        (resource.data.audience == 'role' && resource.data.toRole == role()) ||
        (resource.data.audience == 'user' && resource.data.toUserId == request.auth.uid) ||
        isAdmin()
      );
      allow create, delete: if role() == 'admin';
      allow update: if role() == 'admin';
    }

    match /holidays/{hid} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if role() == 'admin';
    }

    match /expenses/{eid} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /salary/{sid} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---- AUDIT LOG: append-only ----
    match /auditLog/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
